# Server Configuration
PORT=5000
NODE_ENV=development

# Database — use MongoDB Atlas connection string for production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campusai?retryWrites=true&w=majority

# JWT — use a strong random secret (min 32 characters)
JWT_SECRET=replace_this_with_a_strong_random_secret_min_32_chars

# Client URL — used for CORS (no trailing slash)
CLIENT_URL=http://localhost:5173

# ── AI (Phase 2+) ─────────────────────────────────────────────────────────────
# OpenAI API Key — required for AI tutor, summaries, document Q&A, and quizzes.
# BACKEND ONLY. Never expose to frontend.
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace_with_your_openai_key

# OpenAI model to use for AI features
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible provider endpoint (leave unset for OpenAI)
# OPENAI_BASE_URL=https://api.example.com/v1

# Password reset email — Resend API key and a verified sender address.
# Get a key at: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=CampusAI <no-reply@your-domain.com>

# ── File Upload ────────────────────────────────────────────────────────────────
# Maximum PDF upload size in megabytes
MAX_FILE_SIZE_MB=20

# Upload directory (optional — defaults to server/uploads/)
# UPLOAD_DIR=./uploads
